rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Chat Messages Rules
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Blog System Rules
    match /blogs/{blogId} {
      // Public: Anyone can read
      allow read: if true;
      
      // Restricted: Only users with @lemhand.com email can create
      allow create: if request.auth != null 
                   && request.auth.token.email.matches('.*@lemhand.com')
                   && request.resource.data.authorId == request.auth.uid;
      
      // Owner only: Only the author can edit/delete
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // LAS Clients Rules
    match /las_clients/{clientId} {
      allow read: if true;
    }

    // Homepage Settings Rules
    match /settings/{document} {
      // Anyone can read the homepage config
      allow read: if true;
      // Only LemHand employees can edit the config
      allow write: if request.auth != null && request.auth.token.email.matches('.*@lemhand.com');
    }
  }
}